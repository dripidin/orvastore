# TikTok Business Marketing API (Lead Generation) — Server-Side Only (NEVER use NEXT_PUBLIC_*)
# 1. Application Identity
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_API_VERSION=v1.3
# Explicit operating mode: local | test | mocked_sandbox | tiktok_sandbox | production
TIKTOK_ENV=local
# Optional (REQUIRES VERIFICATION): enforce strictly numeric Portal App ID (8-25 digits)
TIKTOK_STRICT_NUMERIC_APP_ID=false

# 2. OAuth & Token Encryption
# Required scopes on TikTok Developer Portal: 12010100 (Leads Retrieval), 12020100 (Test Leads)
TIKTOK_REDIRECT_URI=https://orva-store.com/api/integrations/tiktok/callback/
# Required 32-byte key (64 hex chars or 32-byte base64) for AES-256-GCM token encryption at rest
TIKTOK_TOKEN_ENCRYPTION_KEY=

# 3. Webhooks & Rate Limiting
# Webhook endpoint URL to register in TikTok Portal: https://orva-store.com/api/integrations/tiktok/webhook/
TIKTOK_WEBHOOK_SECRET=
# Optional (REQUIRES VERIFICATION): set true once portal confirms dedicated webhook secret is distinct from App Secret
TIKTOK_REQUIRE_DEDICATED_WEBHOOK_SECRET=false
TIKTOK_WEBHOOK_MAX_AGE_SECONDS=300
TIKTOK_WEBHOOK_RATE_LIMIT_MAX=60
TIKTOK_WEBHOOK_GLOBAL_RATE_LIMIT_MAX=300
# Optional verified Hostinger reverse-proxy client IP header (e.g., x-real-ip or cf-connecting-ip once verified)
TIKTOK_TRUSTED_IP_HEADER=

# 4. Business Authorization
# Optional pinned TikTok Advertiser ID reference (active selection is persisted per store in Supabase)
TIKTOK_ADVERTISER_ID=

# 5. Internal Security & Feature Flags
TIKTOK_SYNC_CRON_SECRET=
TIKTOK_SANDBOX_MODE=false
# Opt-in flag for non-blocking Telegram alerts on newly imported TikTok Lead pending orders (default: false)
TIKTOK_TELEGRAM_ALERTS_ENABLED=false

