# ==============================================================================
# ORVA STORE v2.1.0 — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production)
# Target Deployment Host: Vercel Production
# Connected Supabase Cloud Project: olmsjkhdfghyydogcvvy (OrvaStore Eccommerce, eu-west-1)
# Primary Courier Platform: Redex EcoTrack Algeria (https://redex.ecotrack.dz)
# ==============================================================================
#
# INSTRUCTIONS FOR OPERATORS:
# 1. In Vercel Project Settings -> Environment Variables, add all variables below
#    for the "Production" environment.
# 2. DO NOT commit production secrets (.env, .env.local, .env.production) to Git.
# 3. Refer to ORVA_OFFICIAL_LAUNCH_REPORT.md for full architectural specifications.
# ==============================================================================

# ── 1. SUPABASE CLOUD DATABASE CONFIGURATION ──────────────────────────────────
# Public Supabase project REST & PostgREST endpoint
NEXT_PUBLIC_SUPABASE_URL=https://olmsjkhdfghyydogcvvy.supabase.co

# Public anonymous key used by storefront shoppers for catalog read & checkout inserts.
# Governed strictly by PostgreSQL Row Level Security (RLS) policies.
# Format: Publishable key (sb_publishable_...) or standard anon JWT
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# CRITICAL SECURITY RULE: Privileged operations require a genuine service_role key.
# Retrieve from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role (secret)
# NEVER use a publishable key (sb_publishable_...) here! The server strictly fails closed if invalid.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── 2. ADMINISTRATIVE AUTHENTICATION & HMAC SESSIONS ─────────────────────────
# Master password for the /admin.html and /auth/v1/login administrative dashboards.
# CRITICAL SECURITY RULE: In production (NODE_ENV=production), development fallback
# passwords ("admin123", "orva2026") are strictly rejected. Set a strong password (16+ chars).
ADMIN_PASSWORD=your-super-strong-production-admin-password-here

# Cryptographic HMAC-SHA256 signing secret for 24-hour admin session tokens
# and delivery reconciliation recovery receipts.
# CRITICAL SECURITY RULE: Minimum 16 characters required (32-64 hex chars strongly recommended).
# Generate via: openssl rand -hex 32
ADMIN_JWT_SECRET=your-32-to-64-character-random-hex-or-base64-secret-key-here

# ── 3. REDEX ECOTRACK COURIER LOGISTICS (REQUIREMENT B) ──────────────────────
# Redex EcoTrack platform API token for order creation (prete_a_expedier) and parcel tracking.
# Invariant: Parcels are created unvalidated; zero automatic validation occurs.
REDEX_API_TOKEN=your-redex-ecotrack-api-token-here

# Redex EcoTrack platform gateway URLs (trailing slashes stripped automatically)
ECOTRACK_BASE_URL=https://redex.ecotrack.dz
REDEX_BASE_URL=https://redex.ecotrack.dz

# ── 4. BASE APPLICATION URL ──────────────────────────────────────────────────
# Canonical storefront base URL used in order links, customer redirects, and Telegram alerts.
NEXT_PUBLIC_APP_URL=https://orvastore.com

# ── 5. META TRACKING (PIXEL & CONVERSIONS API / CAPI) ────────────────────────
# Meta Pixel ID for client-side browser event tracking (PageView, ViewContent, InitiateCheckout)
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id-here

# Meta Pixel ID for server-side Conversions API (CAPI) purchase tracking
META_PIXEL_ID=your-meta-pixel-id-here

# Meta Conversions API System User Access Token (EAAB...)
# Used by triggerMetaCapiPurchase for server-side deduplicated Purchase events
META_CAPI_TOKEN=your-meta-conversions-api-system-user-token-here

# Meta Test Event Code (Debug only — leave BLANK in live production)
# META_TEST_EVENT_CODE=TEST12345

# ── 6. TELEGRAM BOT ORDER ALERTS (OPTIONAL) ──────────────────────────────────
# Telegram Bot API token from @BotFather for instant Arabic order dispatch alerts
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Telegram target group or channel chat ID (typically negative for supergroups)
TELEGRAM_CHAT_ID=your-telegram-channel-or-group-chat-id-here

# ── 7. SECONDARY COURIER INTEGRATIONS (OPTIONAL) ─────────────────────────────
# Yalidine Express credentials
YALIDINE_API_ID=
YALIDINE_API_TOKEN=

# ZR Express credentials
ZR_EXPRESS_API_KEY=
ZR_EXPRESS_API_SECRET=

# ── 8. ENVIRONMENT SAFETY & FAIL-CLOSED GATES ────────────────────────────────
# Production environment indicator
NODE_ENV=production

# Safety gate: strictly disable demo sandbox mode in live production
NEXT_PUBLIC_ALLOW_DEMO_MODE=false

# Safety gate: strictly disable development authentication bypass in production
DEV_BYPASS_ADMIN_AUTH=false
